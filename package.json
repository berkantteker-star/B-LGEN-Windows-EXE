{
  "name": "bilgem-windows",
  "version": "1.1.0",
  "private": true,
  "description": "BİLGEM Windows desktop build of DAVIVA LAB",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tr.bilgem.desktop",
    "productName": "BİLGEM",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "BILGEM-Setup-${version}-${arch}.${ext}"
    },
    "publish": null,
    "portable": {
      "artifactName": "BILGEM-Portable-${version}-${arch}.${ext}"
    },
    "asarUnpack": [
      "**/*.node"
    ]
  },
  "author": "BİLGEM",
  "dependencies": {
    "better-sqlite3": "^11.8.1"
  }
}
